{
  "manifest_version": 3,
  "name": "栖页 · 书签桌面",
  "version": "1.2.0",
  "description": "Qiye — Bookmark Desktop: browse and organize bookmarks, save links, and import open tabs into your configured server.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "栖页 · 书签桌面",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
