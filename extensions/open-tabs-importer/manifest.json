{
  "manifest_version": 3,
  "name": "SmartTools Tabs Importer",
  "version": "1.2.0",
  "description": "Browse your built-in SmartTools homepage, manage bookmarks and groups, sign in, and import open tabs.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Import open tabs to SmartTools",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ]
}
